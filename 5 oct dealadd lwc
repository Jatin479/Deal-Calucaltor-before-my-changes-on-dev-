                        required>
                    </lightning-input>
                    <template if:true={selectedProductId}>
                        <div class="slds-form-element__help slds-text-color_success">
                            Max: {currentMaxVolume}
                        </div>
                    </template>
                </lightning-layout-item>

                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
                    <lightning-input
                        type="number"
                        label="Discount %"
                        value={entryDiscount}
                        onchange={handleDiscountChange}
                        min="0"
                        max="100"
                        step="0.01"
                        disabled={isProductNotSelected}
                        required>
                    </lightning-input>
                </lightning-layout-item>

                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
                    <lightning-input
                        type="number"
                        label="ATR Discount (Rs/L)"
