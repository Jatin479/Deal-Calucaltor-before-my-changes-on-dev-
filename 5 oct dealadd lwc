                            <div class="slds-box slds-theme_default">
                                <div class="line-item-row">
                                    <div class="line-item-product slds-text-title_bold">{item.productName}</div>
                                    <div class="line-item-field">
                                        <span class="line-item-label">Volume</span>
                                        <span class="line-item-value">{item.volume}</span>
                                    </div>
                                    <div class="line-item-field">
                                        <span class="line-item-label">Total Discount in INR</span>
                                        <lightning-formatted-number class="line-item-value" value={item.totalCalculatedDiscountAmountINR} format-style="currency"></lightning-formatted-number>
                                    </div>
                                    <div class="line-item-field">
                                        <span class="line-item-label">Discount %</span>
                                        <span class="line-item-value">{item.discount}</span>
                                    </div>
                                    <div class="line-item-field">
                                        <span class="line-item-label">DPL</span>
                                        <lightning-formatted-number class="line-item-value" value={item.dpl} format-style="currency"></lightning-formatted-number>
