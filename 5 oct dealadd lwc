.rowBox {
    border: 1px solid #d8dde6;
    border-radius: 0.25rem;
    background: #ffffff;
}

.line-item-row {
    display: grid;
    width: 100%;
    box-sizing: border-box;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.7fr) minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1.3fr) 72px;
    align-items: center;
    gap: 8px;
}

.line-item-field {
    min-width: 0;
}

.line-item-label {
    display: block;
    margin-bottom: 4px;
    color: var(--lwc-colorTextLabel, #444);
    font-size: 0.75rem;
}

.line-item-value {
    display: block;
    overflow-wrap: anywhere;
}

.line-item-product {
    min-width: 0;
    overflow-wrap: anywhere;
}

.line-item-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    white-space: nowrap;
}

@media (max-width: 860px) {
    .line-item-row {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .line-item-product {
        grid-column: span 2;
    }

    .line-item-actions {
        justify-content: flex-start;
    }
}

@media (max-width: 560px) {
    .line-item-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .line-item-product,
    .line-item-actions {
        grid-column: 1 / -1;
    }
}
