                    </lightning-input>
                </lightning-layout-item>

                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
                    <lightning-input
                        type="number"
                        label="Season Scheme/Club Discount (Rs/L)"
                        value={entrySeasonSchemeClubDiscount}
                        data-field="entrySeasonSchemeClubDiscount"
                        onchange={handleAdditionalDiscountChange}
                        min="0"
                        step="0.01"
                        formatter="currency"
                        disabled={isProductNotSelected}>
                    </lightning-input>
                </lightning-layout-item>

                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
                    <lightning-input
                        type="number"
                        label="Special Tie-up Discount (Rs/L)"
                        value={entrySpecialTieupDiscount}
                        data-field="entrySpecialTieupDiscount"
                        onchange={handleAdditionalDiscountChange}
                        min="0"
                        step="0.01"
                        formatter="currency"
                        disabled={isProductNotSelected}>
                    </lightning-input>
                </lightning-layout-item>

                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
                    <lightning-input
                        type="number"
                        label="Others Discount (Rs/L)"
                        value={entryOthersDiscount}
                        data-field="entryOthersDiscount"
                        onchange={handleAdditionalDiscountChange}
                        min="0"
                        step="0.01"
                        formatter="currency"
                        disabled={isProductNotSelected}>
                    </lightning-input>
                </lightning-layout-item>

                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
                    <lightning-input
                        type="number"
                        label="DPL"
                        value={entryDpl}
                        formatter="currency"
                        disabled>
                    </lightning-input>
                </lightning-layout-item>

                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
                    <lightning-input
                        type="number"
                        label="Sales Price"
                        value={entryCogs}
                        formatter="currency"
                        disabled>
                    </lightning-input>
                </lightning-layout-item>

                <lightning-layout-item size="12" class="slds-m-top_small slds-text-align_right">
                    <div class="slds-text-title_bold slds-float_left slds-p-top_x-small">
                        <span>Total amount:</span>
                        <lightning-formatted-number value={entryTotal} format-style="currency"></lightning-formatted-number>
                    </div>
                    <lightning-button label={addButtonLabel} variant="brand" onclick={handleAddProduct} disabled={isProductNotSelected}></lightning-button>
                </lightning-layout-item>
            </lightning-layout>
        </div>

        <!-- Bottom Section: Draft / Existing Items -->
        <div class="slds-p-around_medium slds-theme_shade">
            <div class="slds-text-heading_small slds-m-bottom_medium slds-text-title_bold">
                Line Items ({draftItems.length})
            </div>

            <template if:true={draftItems.length}>
                <lightning-layout multiple-rows="true">
                    <template for:each={draftItems} for:item="item" for:index="index">
