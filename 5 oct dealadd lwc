<template>
    <lightning-card>
        <div class="slds-text-heading_medium slds-text-align_center slds-p-top_medium">
            Add Deal Products
        </div>

        <!-- Top Section: Data Entry Form -->
        <div class="slds-p-around_medium slds-border_bottom slds-theme_default">
            <lightning-layout multiple-rows="true">
                <lightning-layout-item size="12" medium-device-size="4" class="slds-p-horizontal_x-small slds-m-bottom_small">
